# ===== macOS =====
.DS_Store

# ===== 项目临时目录（唯一临时产物归宿，见 STRUCTURE.md）=====
tmp/*
!tmp/.gitkeep

# ===== 报告输出目录（测试/覆盖率/E2E 汇总，见 STRUCTURE.md §2.11）=====
# 机器产物拦截；人工报告（.md）白名单入库
reports/*
!reports/.gitkeep
!reports/*.md

# ===== 密钥与环境（红线：永不提交）=====
.env
.env.*
!.env.example

# ===== 编辑器 =====
.idea/
.vscode/
*.swp
*~

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== Node =====
node_modules/
dist/
.next/
coverage/

# ===== Java / Maven =====
target/
*.class
*.jar
!deploy/**/*.jar

# ===== Playwright / E2E =====
tests/e2e/playwright-report/
tests/e2e/test-results/
tests/e2e/blob-report/

# ===== 日志 =====
*.log
frontend/parent-h5/.swc/
.deploy-state
