# ===== macOS =====
.DS_Store

# ===== 项目临时目录（唯一临时产物归宿，见 STRUCTURE.md）=====
tmp/*
!tmp/.gitkeep

# ===== 报告输出目录（测试/覆盖率/E2E 汇总，见 STRUCTURE.md §2.11）=====
# 机器产物拦截；人工报告（.md）白名单入库
reports/*
!reports/.gitkeep
!reports/*.md
# DOC-087：browser-test 子目录（三端遍历测试报告/截图）白名单入库
!reports/browser-test/
!reports/browser-test/**

# ===== 密钥与环境（红线：永不提交）=====
.env
.env.*
!.env.example

# ===== 编辑器 =====
.idea/
.vscode/
*.swp
*~

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# tts 离线 wheels（可再生产物，不入库；需要时跑 refresh-wheels.sh 生成）
backend/tts-service/wheels/

# ===== Node =====
node_modules/
dist/
.next/
coverage/

# ===== Java / Maven =====
target/
*.class
*.jar
!deploy/**/*.jar

# ===== Playwright / E2E =====
tests/e2e/playwright-report/
tests/e2e/test-results/
tests/e2e/blob-report/

# ===== 日志 =====
*.log
logs/deploy/
logs/deploy/audit-*.md   # DOC-078 部署审计报告（运行时产物，不提交）
frontend/parent-h5/.swc/
.deploy-state

# ===== 模型缓存（FunASR 模型 ~3GB，不入库）=====
deploy/cache/
cache/modelscope/
