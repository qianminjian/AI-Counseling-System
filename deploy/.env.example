# ===== MindSafe 部署环境变量 =====
# 复制为 .env 后逐项填写：cp .env.example .env
# ⚠️ 所有 <...> 占位符均为必填项，上线前必须替换为真实强随机值，不得直接使用本文件。

# ----- 数据库（必填） -----
DB_PASSWORD=<CHANGE_ME_DB_PASSWORD>

# ----- Redis（必填） -----
REDIS_PASSWORD=<CHANGE_ME_REDIS_PASSWORD>

# ----- JWT 认证（必填，≥ 32 字符随机串，建议 64；可用 openssl rand -base64 48 生成） -----
JWT_SECRET=<CHANGE_ME_RANDOM_64_CHARS>

# ----- 字段加密（默认不启用；AES-256-GCM；Base64 编码的 32 字节密钥，可用 openssl rand -base64 32 生成） -----
# ⚠️ 系统级开关 ENCRYPTION_ENABLED：false=不启用（默认，可不配置密钥，数据明文落库）；true=启动必须配置合法密钥并执行加解密
# ⚠️ 启用加密属于商业化阶段要求（frozen/60 COMP-008），试运行期保持默认关闭
ENCRYPTION_ENABLED=false
# 以下三项仅 ENCRYPTION_ENABLED=true 时生效
ENCRYPTION_KEY=<CHANGE_ME_BASE64_32_BYTES>
ENCRYPTION_KEY_VERSION=1
# 历史密钥（轮换期多版本解密用，格式：version:base64key,version:base64key）
ENCRYPTION_PREVIOUS_KEYS=

# ----- LLM 主模型（必填；key 主命名，任意 OpenAI 兼容供应商，doing/63） -----
LLM_PRIMARY_API_KEY=<CHANGE_ME_LLM_PRIMARY_API_KEY>
# 以下均为可选：application.yml 已有相同默认值，仅切换供应商/调参时才需覆盖
LLM_PRIMARY_BASE_URL=https://api.deepseek.com
LLM_PRIMARY_MODEL=deepseek-v4-flash
LLM_PRIMARY_TEMPERATURE=0.7
LLM_PRIMARY_MAX_TOKENS=2048
# 供应商专属请求体参数（可选，JSON 字符串，如 {"enable_thinking":false}）
# DeepSeek 主模型未配置时自动注入 enable_thinking=false（首 token 延迟优化）；非 deepseek 不注入
LLM_PRIMARY_EXTRA_BODY=

# ----- LLM 备份模型（可选：为空 = 单模型模式；key 备命名，任意 OpenAI 兼容供应商） -----
LLM_BACKUP_API_KEY=
LLM_BACKUP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BACKUP_MODEL=qwen-plus
LLM_BACKUP_TEMPERATURE=0.7
LLM_BACKUP_MAX_TOKENS=2048
LLM_BACKUP_EXTRA_BODY=

# ⚠️ deprecated（迁移期回退兼容，新部署请勿使用；代码回退链保留）：
#   LLM_API_KEY / LLM_BASE_URL / LLM_MODEL → 迁移为 LLM_PRIMARY_* 同名含义
#   LLM_FALLBACK_API_KEY / LLM_FALLBACK_BASE_URL / LLM_FALLBACK_MODEL → 迁移为 LLM_BACKUP_*
#   DEEPSEEK_API_KEY → 三级回退链末级，新部署不再使用（LLM-GEN-012）

# ----- 短信服务（家长手机验证） -----
# provider: logging（默认，仅日志）| aliyun（正式启用短信时切换）
# 设计修正（2026-08-06）：试点期 SMS 未启用，无 aliyun 凭证，prod compose 默认 logging（LoggingSmsService 在 prod profile 下也可加载）；
# 正式启用短信时在 .env 设置 SMS_PROVIDER=aliyun 并补齐下方 4 个 aliyun 凭证即可。
SMS_PROVIDER=logging
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=

# ----- 监护人同意（AUTH-040，PIPL §31） -----
# false=生产默认：age<14 注册后必须走 SMS 验证码闭环才能对话
# true=试运行：注册时自动写入监护人同意（跳过 SMS，仅限内部试点）
# 注意：变量名必须带 MINDSAFE_ 前缀，与 application.yml 占位符 ${MINDSAFE_CONSENT_TRIAL_AUTO_GRANT} 一致
MINDSAFE_CONSENT_TRIAL_AUTO_GRANT=false

# ----- 企业微信 OAuth（可选） -----
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_REDIRECT_URI=https://yun.gxjugu.com/api/v1/wecom/callback

# ----- 监控告警接收人（P1-10：Alertmanager → 企微应用消息，可选） -----
# 企微 userid（多个用 | 分隔）；@all = 全员（需应用有"发送到全员"权限）
# 留空 = 告警仅留存 Alertmanager 不推送（与业务告警"空 = 日志降级"约定一致）
WECOM_ALERT_TO_USER=

# ----- 告警 Webhook（可选，空 = 降级为日志告警） -----
# 业务告警（风险事件 SLA 等）：compose 层映射 ALERT_WECOM_* → MINDSAFE_ALERT_WECOM_*（docker-compose.prod.yml）
# 配了才能推企微群机器人；留空 = 告警仅写日志（当前状态），正式启用时填写 webhook 地址即可
ALERT_WECOM_WEBHOOK_URL=
ALERT_WECOM_MENTIONED=

# ----- ASR 引擎选择 -----
# funasr = 本地自部署 FunASR SenseVoiceSmall（需 4GB 内存，适合私有化/信创/数据不出境）
# dashscope = 阿里云 DashScope Paraformer-V2（云端 ASR，低 CPU 占用）
ASR_ENGINE=dashscope
# ----- SER 情感分析（本地 emotion2vec+，独立于 ASR 引擎） -----
# true = 加载 emotion2vec+ 做语音情感识别（额外需约 2-4GB 内存，加载峰值实测 >4.2GB）
# false = 禁用 SER，情感返回中性（纯文本风险检测仍完整工作）
SER_ENABLED=true
# 内存限制（2026-08-06 实测修正）：ASR=dashscope+SER=on 需 6G（emotion2vec+ 加载峰值 >4.2GB，2G/4G 均会 OOM）
# SER=off 时 512M 即可；变量名与 docker-compose.prod.yml 的 ${VOICE_MEMORY_LIMIT:-6G} 对齐（旧名 VOICE_MEM_LIMIT 不生效）
VOICE_MEMORY_LIMIT=6G
# 模型缓存目录：FunASR 模型持久化到宿主机，避免每次部署重新下载 3GB+ 模型
# 首次使用需运行: bash deploy/scripts/prepare-funasr.sh
# dashscope 模式下此目录为空挂载，不影响运行
MODEL_CACHE_DIR=./cache/modelscope

# ----- TTS 语音合成（阿里云百炼 CosyVoice，必填） -----
# 与 LLM 备用模型共用同一个百炼 API Key，在 https://bailian.console.aliyun.com 获取
# ASR_ENGINE=dashscope 时也使用此 Key
DASHSCOPE_API_KEY=<CHANGE_ME_DASHSCOPE_API_KEY>
# TTS 模型名（可选覆盖：tts-service/config.yaml 已有同默认值，仅紧急切换时用）
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
# TTS 单次合成超时（秒；默认 30，SDK 挂死/网络黑洞时降级或 503，DC-003）
TTS_SYNTHESIZE_TIMEOUT=30
# TTS CORS 白名单（默认拒绝跨域；确需前端直连时逗号分隔，如 https://a.com,https://b.com，DC-003）
TTS_CORS_ORIGINS=

# ----- 监控（可选；P1-DEP：Grafana 密码必填强密码，缺省 compose 直接 fail-fast） -----
# 变量名与 docker-compose.monitoring.yml 的 ${GRAFANA_PASSWORD:?...} 对齐
GRAFANA_PASSWORD=<CHANGE_ME_GRAFANA_PASSWORD>
# Prometheus 抓取目标与标签（可选；默认 backend:8080 / prod）
PROM_TARGETS=backend:8080
PROM_ENV=prod

# ----- HTTP/HTTPS 端口 -----
HTTP_PORT=80
HTTPS_PORT=443

# ----- CORS 允许域名（多域名用逗号分隔） -----
CORS_ORIGINS=https://yun.gxjugu.com
