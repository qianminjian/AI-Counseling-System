# ===== MindSafe 部署环境变量 =====
# 复制为 .env 后修改：cp .env.example .env

# ----- 数据库 -----
DB_PASSWORD=mindsafe2026

# ----- Redis -----
REDIS_PASSWORD=redis2026

# ----- JWT 认证 -----
JWT_SECRET=change-this-to-a-random-64-char-string

# ----- DeepSeek AI -----
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ----- 短信服务（家长手机验证） -----
# provider: logging（开发，仅日志）| aliyun（生产）
SMS_PROVIDER=logging
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=

# ----- 企业微信 OAuth（可选） -----
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_REDIRECT_URI=https://yun.gxjugu.com/api/v1/wecom/callback

# ----- 语音服务（可选，需 GPU 服务器） -----
VOICE_SERVICE_URL=http://voice-service:10095
TTS_SERVICE_URL=http://tts-service:10096

# ----- 监控（可选） -----
GRAFANA_ADMIN_PASSWORD=admin

# ----- HTTP 端口 -----
HTTP_PORT=80

# ----- CORS 允许域名（多域名用逗号分隔） -----
CORS_ORIGINS=https://yun.gxjugu.com
