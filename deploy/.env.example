# ===== MindSafe 部署环境变量 =====
# 复制为 .env 后修改：cp .env.example .env

# ----- 数据库 -----
DB_PASSWORD=mindsafe2026

# ----- JWT 认证 -----
JWT_SECRET=change-this-to-a-random-64-char-string

# ----- DeepSeek AI -----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ----- 企业微信 OAuth（可选） -----
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_REDIRECT_URI=https://your-domain.com/api/v1/wecom/callback

# ----- 语音服务（可选，需 GPU 服务器） -----
VOICE_SERVICE_URL=http://voice-service:10095
TTS_SERVICE_URL=http://tts-service:10096

# ----- 监控（可选） -----
GRAFANA_ADMIN_PASSWORD=admin
