<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mindsafe</groupId>
        <artifactId>counseling-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>counseling-app</artifactId>
    <name>counseling-app</name>
    <description>启动模块：Spring Boot 主类、配置装配、打包（fat jar / Docker）</description>

    <dependencies>
        <!-- 聚合所有业务模块 -->
        <dependency>
            <groupId>com.mindsafe</groupId>
            <artifactId>counseling-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mindsafe</groupId>
            <artifactId>counseling-tenant</artifactId>
        </dependency>
        <!-- 以下四个为传递依赖显式声明：jacoco report-aggregate 仅聚合直接依赖模块 -->
        <dependency>
            <groupId>com.mindsafe</groupId>
            <artifactId>counseling-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mindsafe</groupId>
            <artifactId>counseling-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mindsafe</groupId>
            <artifactId>counseling-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mindsafe</groupId>
            <artifactId>counseling-service</artifactId>
        </dependency>

        <!-- 运行时基础设施 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 结构化日志（JSON 格式，生产环境用） -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>

        <!-- 集成测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- 覆盖率聚合报告：汇总全部依赖模块的 exec 数据，输出 target/site/jacoco-aggregate/（CI 门禁读取） -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
